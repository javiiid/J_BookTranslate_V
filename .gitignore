crp.txt


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ============================================================
# Virtual Environment
# ============================================================

.venv/
venv/
env/
ENV/

# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*
!.env.example

# API keys / credentials
*.key
# Named rather than a blanket `*.yaml`: a wildcard here also silently drops
# .github/workflows/*.yaml, docker-compose.yaml, pyproject-style config and any
# future packaging file, and nothing warns you because git just ignores them.
# The live key lives in exactly one file, so name that file.
config/config.yaml
config/*.local.yaml
config/*.local.yml
*.pem
secrets.json
credentials.json

