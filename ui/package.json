{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-fonts.mjs && node scripts/check-brand.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-fonts.mjs && node scripts/check-brand.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b --force",
    "lint": "oxlint",
    "preview": "vite preview",
    "pretest": "vite build",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test",
    "audit:contrast": "vite build && node scripts/audit-contrast.mjs",
    "check:api": "node scripts/check-contract.mjs",
    "check:normalisation": "node scripts/normalisation-probe.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
