# Generated by ../docs/build_fonts.py from the Python project's woff2 files.
# Not tracked: it goes stale the moment a weight changes there, and the source of
# truth for binary assets is the Python repo.
src/styles/fonts.generated.css

# Font files copied by the same script, for the same reason.
public/fonts/

# A snapshot of one user's library, book titles and job ids, captured from the
# running backend for the contrast audit. Not tracked.
scripts/page-data.json

# The rendered previews, for the same reason: the page markup is written out
# with the real payloads already inlined, so each file is 40KB of one user's
# data. Regenerate with `node scripts/render-preview.mjs`.
scripts/preview/

